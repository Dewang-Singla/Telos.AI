# Supabase dashboard > Project settings > API. These two values are public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Your production origin, with no trailing slash; localhost works for development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google AI Studio API key. Server only. Use an eligible free-tier project.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Semantic retrieval gate; tune using labeled examples, not engagement metrics.
MATCH_MIN_SIMILARITY=0.55
